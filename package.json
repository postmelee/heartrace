{
  "name": "heartrace",
  "version": "0.1.0",
  "private": true,
  "description": "심장 박동 한 번이 한 걸음이 되는 실시간 경주 게임 — 심장달리기",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,host -c cyan,magenta \"npm run dev -w @heartrace/server\" \"npm run dev -w @heartrace/host\"",
    "dev:server": "npm run dev -w @heartrace/server",
    "dev:host": "npm run dev -w @heartrace/host",
    "dev:mobile": "npm run start -w @heartrace/mobile",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke-race.ts",
    "smoke:relay": "tsx scripts/smoke-relay.ts",
    "smoke:demo": "tsx scripts/smoke-demo.ts",
    "simulate:hybrid-relay": "tsx scripts/simulate-hybrid-relay.ts",
    "benchmark:ppg:but": "tsx scripts/benchmark-butppg.ts",
    "analyze:ppg:trace": "tsx scripts/analyze-ppg-trace.ts",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "socket.io-client": "4.8.3",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=22"
  }
}
