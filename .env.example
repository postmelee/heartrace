# 브라우저/앱에서 접근 가능한 Socket.IO 주소입니다.
# 실제 휴대폰으로 로컬 테스트할 때 localhost 대신 Mac의 LAN IP를 사용하세요.
VITE_SOCKET_URL=http://localhost:3001
EXPO_PUBLIC_SOCKET_URL=http://localhost:3001
# 기기 보정 때만 true로 설정합니다. 배포 UI에서는 기본적으로 숨겨집니다.
EXPO_PUBLIC_SHOW_DIAGNOSTICS=false

# 쉼표로 구분한 허용 Origin. 비워두면 개발 환경에서 모두 허용합니다.
CORS_ORIGINS=http://localhost:5173
PORT=3001
