{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SOCKET_URL": "https://heartrace-api-postmelee.onrender.com",
        "EXPO_PUBLIC_PUBLIC_URL": "https://heartrace-postmelee.onrender.com",
        "EXPO_PUBLIC_SHOW_DIAGNOSTICS": "false",
        "EXPO_PUBLIC_ENABLE_RACE_PREVIEW": "true"
      }
    },
    "testflight": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_ENABLE_RACE_PREVIEW": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SOCKET_URL": "https://heartrace-api-postmelee.onrender.com",
        "EXPO_PUBLIC_PUBLIC_URL": "https://heartrace-postmelee.onrender.com",
        "EXPO_PUBLIC_SHOW_DIAGNOSTICS": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6800291252"
      }
    }
  }
}
